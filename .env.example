# База данных. По умолчанию SQLite для локальной разработки.
DATABASE_URL="file:./dev.db"

# Для продакшена на PostgreSQL замените на строку подключения и используйте
# npm run pg:prepare (миграции + сид) вместо db:push:
# DATABASE_URL="postgresql://user:password@host:5432/casegames"

# Токен бота от @BotFather (https://t.me/BotFather). Если пусто — бот работает
# в mock-режиме: Mini App и API полностью функциональны, бот не отвечает.
BOT_TOKEN=""

# Публичный HTTPS-URL развёрнутого Mini App, например https://example.com
WEBAPP_URL="https://example.com"

# Случайная строка: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""

# Защита /api/cron/* (Authorization: Bearer). Сгенерируй: openssl rand -hex 32.
# Без него setup-cron.sh откажется ставить cron-задачи.
CRON_SECRET=""

# Short name вашего Mini App из /newapp (для ссылки t.me/<bot>/<app>). Необязательно.
APP_SHORT_NAME=""

# 1 — вход в Mini App из обычного браузера. Действует ТОЛЬКО вне прод-сборки
# (next dev); прод-бандл игнорирует эту переменную всегда. Можно оставить 0.
NEXT_PUBLIC_DEV_MODE=0
