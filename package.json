{
  "name": "case-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "pg:schema": "tsx scripts/gen-pg-schema.ts",
    "pg:migrate": "npm run pg:schema && prisma migrate dev --schema=prisma/schema.postgres.prisma",
    "pg:prepare": "npm run pg:schema && prisma generate --schema=prisma/schema.postgres.prisma && prisma migrate deploy --schema=prisma/schema.postgres.prisma && npm run db:seed",
    "tg:webhook": "tsx scripts/tg-webhook.ts",
    "stars:refund": "tsx scripts/stars-refund.ts",
    "deploy-check": "tsx scripts/deploy-check.ts",
    "selfcheck": "tsx scripts/selfcheck.ts",
    "selfcheck:modes": "tsx scripts/selfcheck-modes.ts",
    "e2e": "tsx scripts/e2e.ts",
    "e2e:modes": "tsx scripts/e2e-modes.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
